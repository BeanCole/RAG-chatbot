# Copy to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=

# Service URLs (defaults target the docker-compose network)
QDRANT_URL=http://qdrant_db:6333
DATABASE_URL=mysql+pymysql://root:root@mysql:3306/ecommerce_db?charset=utf8mb4

# MySQL container root password (used by docker-compose)
MYSQL_ROOT_PASSWORD=root

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:8081

# Enable LLM-based reranking of retrieved chunks (adds latency + cost)
RERANK_ENABLED=false
